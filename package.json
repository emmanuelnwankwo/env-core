{
  "name": "env-core",
  "version": "1.1.1",
  "description": "Library for validating and accessing environment variables.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.d.ts",
    "require": "./dist/index.js"
  },
  "homepage": "https://github.com/emmanuelnwankwo/env-core#readme",
  "bugs": {
    "url": "https://github.com/emmanuelnwankwo/env-core/issues",
    "email": "noblenec@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/emmanuelnwankwo/env-core.git"
  },
  "scripts": {
    "build": "tsc",
    "prepublish": "pnpm run build",
    "test": "jest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "env",
    "validator",
    "express",
    "nestjs",
    "process.env",
    "environment"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Emmanuel Nwankwo <noblenec@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsr": "^0.14.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "packageManager": "pnpm@12.15.0"
}
