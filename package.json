{
  "name": "env-core",
  "version": "2.0.0",
  "description": "Lightweight, type-safe environment variable validation for Node.js and TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "env-core": "dist/cli.js"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "default": "./dist/index.js"
  },
  "homepage": "https://github.com/emmanuelnwankwo/env-core#readme",
  "bugs": {
    "url": "https://github.com/emmanuelnwankwo/env-core/issues",
    "email": "noblenec@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/emmanuelnwankwo/env-core.git"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "jest",
    "benchmark": "nub --no-env-file scripts/benchmark.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm run build",
    "verify:release": "nub --no-env-file scripts/release.ts",
    "verify:consumer": "nub --no-env-file scripts/consumer.ts"
  },
  "keywords": [
    "env",
    "validator",
    "express",
    "nestjs",
    "process.env",
    "environment",
    "typescript",
    "type-safe",
    "environment-variables",
    "environment-validation",
    "configuration",
    "dotenv"
  ],
  "files": [
    "dist",
    "!dist/cli.d.ts",
    "!dist/constraints.d.ts",
    "!dist/validators.d.ts",
    "!dist/types.js",
    "README.md"
  ],
  "author": "Emmanuel Nwankwo <noblenec@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nubjs/nub": "0.9.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@yarnpkg/cli-dist": "4.18.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-5": "npm:typescript@5.6.3",
    "yarn-classic": "npm:yarn@1.22.22"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "packageManager": "pnpm@12.15.0"
}
